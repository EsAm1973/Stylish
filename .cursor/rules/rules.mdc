### Repository Pattern with Either
```dart
import 'package:dartz/dartz.dart';

// Abstract repository (defines contract)
abstract class UserRepository {
  Future<Either<Failure, User>> getUser(String id);
  Future<Either<Failure, Unit>> updateUser(User user);
  Future<Either<Failure, List<User>>> getAllUsers();
}

// Concrete implementation
class UserRepositoryImpl implements UserRepository {
  final UserRemoteDataSource _remoteDataSource;
  final UserLocalDataSource _localDataSource;

  UserRepositoryImpl(this._remoteDataSource, this._localDataSource);

  @override
  Future<Either<Failure, User>> getUser(String id) async {
    try {
      final user = await _remoteDataSource.getUser(id);
      await _localDataSource.cacheUser(user);
      return Right(user);
    } on ServerException {
      // Try local cache on server failure
      try {
        final user = await _localDataSource.getUser(id);
        return Right(user);
      } on CacheException {
        return Left(CacheFailure());
      }
    }
  }

  @override
  Future<Either<Failure, Unit>> updateUser(User user) async {
    try {
      await _remoteDataSource.updateUser(user);
      await _localDataSource.cacheUser(user);
      return const Right(unit);
    } on ServerException {
      return Left(ServerFailure());
    }
  }

  @override
  Future<Either<Failure, List<User>>> getAllUsers() async {
    try {
      final users = await _remoteDataSource.getAllUsers();
      return Right(users);
    } on ServerException {
      return Left(ServerFailure());
    } on NetworkException {
      return Left(NetworkFailure());
    }
  }
}
```

### ViewModel Pattern (ChangeNotifier with Business Logic)
```dart
import 'package:flutter/foundation.dart';
import 'package:dartz/dartz.dart';

class UserViewModel extends ChangeNotifier {
  final UserRepository _repository;

  UserViewModel(this._repository);

  // State
  UserState _state = const UserState.initial();
  UserState get state => _state;

  // Helper method to update state
  void _setState(UserState newState) {
    _state = newState;
    notifyListeners();
  }

  // Business logic: Load user
  Future<void> loadUser(String id) async {
    _setState(const UserState.loading());
    
    final result = await _repository.getUser(id);
    
    result.fold(
      (failure) => _setState(UserState.error(_mapFailureToMessage(failure))),
      (user) => _setState(UserState.loaded(user)),
    );
  }

  // Business logic: Update user with validation
  Future<void> updateUser(User user) async {
    // Validation logic in ViewModel
    if (user.name.isEmpty) {
      _setState(const UserState.error('Name cannot be empty'));
      return;
    }

    if (!_isValidEmail(user.email)) {
      _setState(const UserState.error('Invalid email format'));
      return;
    }

    _setState(const UserState.loading());
    
    final result = await _repository.updateUser(user);
    
    result.fold(
      (failure) => _setState(UserState.error(_mapFailureToMessage(failure))),
      (_) => _setState(UserState.loaded(user)),
    );
  }

  // Business logic: Load all users and filter
  Future<void> loadActiveUsers() async {
    _setState(const UserState.loading());
    
    final result = await _repository.getAllUsers();
    
    result.fold(
      (failure) => _setState(UserState.error(_mapFailureToMessage(failure))),
      (users) {
        // Business logic: filter active users
        final activeUsers = users.where((user) => user.isActive).toList();
        _setState(UserState.loadedList(activeUsers));
      },
    );
  }

  // Helper methods for business logic
  bool _isValidEmail(String email) {
    return RegExp(r'^[\w-\.]+@([\w-]+\.)+[\w-]{2,4}$').hasMatch(email);
  }

  String _mapFailureToMessage(Failure failure) {
    if (failure is ServerFailure) {
      return 'Server error. Please try again.';
    } else if (failure is CacheFailure) {
      return 'Local data error.';
    } else if (failure is NetworkFailure) {
      return 'No internet connection.';
    }
    return 'Unexpected error occurred.';
  }
}
```

