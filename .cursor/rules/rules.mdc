│  - Returns Either<Failure, Data>                    │
└─────────────────────────────────────────────────────┘
```

### GetIt Dependency Injection Setup
```dart
// core/di/injection.dart
import 'package:get_it/get_it.dart';

final getIt = GetIt.instance;

Future<void> setupDependencies() async {
  // External dependencies
  // Example: final sharedPreferences = await SharedPreferences.getInstance();
  // getIt.registerLazySingleton(() => sharedPreferences);

  // Data sources
  getIt.registerLazySingleton<UserRemoteDataSource>(
    () => UserRemoteDataSourceImpl(),
  );
  
  getIt.registerLazySingleton<UserLocalDataSource>(
    () => UserLocalDataSourceImpl(),
  );

  // Repositories
  getIt.registerLazySingleton<UserRepository>(
    () => UserRepositoryImpl(
      getIt<UserRemoteDataSource>(),
      getIt<UserLocalDataSource>(),
    ),
  );

  // ViewModels - registered as factories (new instance each time)
  getIt.registerFactory(
    () => UserViewModel(getIt<UserRepository>()),
  );
}
```

### GoRouter Configuration with ChangeNotifierProvider
```dart
// router/app_router.dart
import 'package:flutter/material.dart';
import 'package:provider/provider.dart';
import 'package:go_router/go_router.dart';
import '../core/di/injection.dart';

final appRouter = GoRouter(
  initialLocation: '/',
  routes: [
    GoRoute(
      path: '/',
      builder: (context, state) => const HomeScreen(),
    ),
    
    // Provide ViewModel at route level using GetIt
    GoRoute(
      path: '/user/:id',
      builder: (context, state) {
        final userId = state.pathParameters['id']!;
        
        return ChangeNotifierProvider(
          create: (context) => getIt<UserViewModel>()..loadUser(userId),
          child: const UserScreen(),
        );
      },
    ),
    
    // Example with multiple ViewModels
    GoRoute(
      path: '/profile',
      builder: (context, state) {
        return MultiProvider(
          providers: [
            ChangeNotifierProvider(
              create: (context) => getIt<ProfileViewModel>()..loadProfile(),
            ),
            ChangeNotifierProvider(
              create: (context) => getIt<SettingsViewModel>()..loadSettings(),
            ),
          ],
          child: const ProfileScreen(),
        );
      },
    ),
    
    // Passing data through navigation
    GoRoute(
      path: '/edit-user',
      builder: (context, state) {
        final user = state.extra as User;
        
        return ChangeNotifierProvider(
          create: (context) => getIt<UserViewModel>()..setUser(user),
          child: const EditUserScreen(),
        );
      },
    ),
  ],
  
  // Error handling
  errorBuilder: (context, state) => ErrorScreen(
    error: state.error.toString(),
  ),
);
```

