### Using ViewModel in UI with Consumer
```dart
// Screen receives ViewModel from router - NO manual instantiation
class UserScreen extends StatelessWidget {
  const UserScreen({super.key});

  @override
  Widget build(BuildContext context) {
    // ViewModel is already provided by ChangeNotifierProvider in app_router.dart
    return Scaffold(
      appBar: AppBar(title: const Text('User Profile')),
      body: Consumer<UserViewModel>(
        builder: (context, viewModel, child) {
          return viewModel.state.when(
            initial: () => const SizedBox.shrink(),
            loading: () => const Center(child: CircularProgressIndicator()),
            loaded: (user) => _buildUserContent(context, user, viewModel),
            loadedList: (users) => _buildUserList(context, users, viewModel),
            error: (message) {
              // Show error snackbar
              WidgetsBinding.instance.addPostFrameCallback((_) {
                ScaffoldMessenger.of(context).showSnackBar(
                  SnackBar(content: Text(message)),
                );
              });
              
              return Center(
                child: Column(
                  mainAxisAlignment: MainAxisAlignment.center,
                  children: [
                    Text(message),
                    const SizedBox(height: 16),
                    ElevatedButton(
                      onPressed: () => viewModel.loadUser('user123'),
                      child: const Text('Retry'),
                    ),
                  ],
                ),
              );
            },
          );
        },
      ),
    );
  }

  Widget _buildUserContent(BuildContext context, User user, UserViewModel viewModel) {
    return Padding(
      padding: const EdgeInsets.all(16.0),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Text('Name: ${user.name}'),
          Text('Email: ${user.email}'),
          const SizedBox(height: 20),
          ElevatedButton(
            onPressed: () {
              final updatedUser = user.copyWith(name: 'New Name');
              viewModel.updateUser(updatedUser);
            },
            child: const Text('Update User'),
          ),
          const SizedBox(height: 10),
          ElevatedButton(
            onPressed: () {
              // Navigate to edit screen with data
              context.push('/edit-user', extra: user);
            },
            child: const Text('Edit User'),
          ),
        ],
      ),
    );
  }

  Widget _buildUserList(BuildContext context, List<User> users, UserViewModel viewModel) {
    return ListView.builder(
      itemCount: users.length,
      itemBuilder: (context, index) {
        final user = users[index];
        return ListTile(
          title: Text(user.name),
          subtitle: Text(user.email),
          onTap: () => context.go('/user/${user.id}'),
        );
      },
    );
  }
}
```

### Using Selector for Optimized Rebuilds
```dart
// Only rebuild when specific state property changes
class UserNameWidget extends StatelessWidget {
  const UserNameWidget({super.key});

  @override
  Widget build(BuildContext context) {
    return Selector<UserViewModel, UserState>(
      selector: (context, viewModel) => viewModel.state,
      builder: (context, state, child) {
        return state.maybeWhen(
          loaded: (user) => Text(user.name),
          orElse: () => const Text('No user'),
        );
      },
    );
  }
}
```

